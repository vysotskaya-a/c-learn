FROM golang:1.25 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /code-runner ./cmd/code-runner

FROM alpine:3.19
RUN apk --no-cache add ca-certificates docker-cli
COPY --from=builder /code-runner /code-runner
EXPOSE 8003
CMD ["/code-runner"]
