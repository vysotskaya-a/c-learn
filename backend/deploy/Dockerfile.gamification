FROM golang:1.25 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /gamification-service ./cmd/gamification-service

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /gamification-service /gamification-service
EXPOSE 8004
CMD ["/gamification-service"]
